# Copy this file to keystore.properties (gitignored) and fill in real values.
# Generate a keystore yourself, e.g.:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias kbwallet
#
# Keep release.jks OUTSIDE the repo (or gitignored if kept inside) and back it up —
# losing it means you can never publish an update under the same app signature again.

storeFile=/absolute/path/to/release.jks
storePassword=changeme
keyAlias=kbwallet
keyPassword=changeme
